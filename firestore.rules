rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Access is limited to the allowed account(s) for now.
    function allowed() {
      return request.auth != null
        && request.auth.token.email in ['sakemadhav97@gmail.com'];
    }
    // Each allowed user can read and write only their own progress document.
    match /users/{uid} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }
    // Lessons are read-only; they are written by scripts/generate_lessons.py.
    match /lessons/{lessonId} {
      allow read: if allowed();
      allow write: if false;
    }
  }
}
